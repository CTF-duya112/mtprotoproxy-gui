# Maintainer: CTF-duya112 <15735369400@qq.com>
pkgname=mtprotoproxy-gui
pkgver=1.0.0
pkgrel=1
pkgdesc="MTProto proxy with a graphical configuration GUI (PySide6, native Wayland)"
arch=('any')
url="https://github.com/CTF-duya112/mtprotoproxy-gui"
license=('MIT')
depends=('python' 'python-pyside6' 'python-cryptography')
source=("mtprotoproxy-gui-$pkgver.tar.gz::https://github.com/CTF-duya112/mtprotoproxy-gui/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SHA256_HERE')

package() {
  cd "$srcdir/mtprotoproxy-gui-$pkgver"

  install -Dm644 gui_wayland.py "$pkgdir/opt/mtprotoproxy-gui/gui_wayland.py"
  install -Dm644 core.py "$pkgdir/opt/mtprotoproxy-gui/core.py"
  cp -r pyaes "$pkgdir/opt/mtprotoproxy-gui/"
  install -Dm644 README.md "$pkgdir/usr/share/doc/mtprotoproxy-gui/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/mtprotoproxy-gui/LICENSE"

  mkdir -p "$pkgdir/usr/share/applications"
  cat > "$pkgdir/usr/share/applications/mtprotoproxy-gui.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=MTProto Proxy GUI
Comment=MTProto proxy configuration GUI
Exec=/usr/bin/mtprotoproxy-gui
Categories=Network;Utility;
EOF

  cat > "$pkgdir/usr/bin/mtprotoproxy-gui" <<'EOF'
#!/bin/sh
exec /usr/bin/python3 /opt/mtprotoproxy-gui/gui_wayland.py "$@"
EOF
  chmod 755 "$pkgdir/usr/bin/mtprotoproxy-gui"
}
